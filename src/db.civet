{ Database } from bun:sqlite
{ homedir } from node:os
{ mkdirSync } from node:fs
{ join } from node:path
* as sqliteVec from sqlite-vec

export CACHE_DIR := join homedir(), ".cache", "lx"
DB_PATH := process.env.LX_DB_PATH ?? join(CACHE_DIR, "cache.db")
SCHEMA_VERSION := 2

mkdirSync CACHE_DIR, { recursive: true }

db := new Database DB_PATH

db.exec """
  PRAGMA journal_mode = WAL;
  PRAGMA synchronous = NORMAL;
  PRAGMA temp_store = MEMORY;
  PRAGMA mmap_size = 268435456;
  PRAGMA cache_size = -20000;
  PRAGMA foreign_keys = ON;
"""

vecAvailable .= false
try
  sqliteVec.load db
  vecAvailable = true
catch
  vecAvailable = false

export isVecAvailable := (): boolean => vecAvailable

currentVersion := (db.prepare "PRAGMA user_version").get() as { user_version: number } | null
existing := currentVersion?.user_version ?? 0
unless existing is SCHEMA_VERSION
  db.exec """
    DROP TABLE IF EXISTS documents_fts;
    DROP TABLE IF EXISTS documents;
    DROP TABLE IF EXISTS document_sources;
  """
  if vecAvailable
    db.exec "DROP TABLE IF EXISTS vec_chunks"
  db.exec `PRAGMA user_version = ${SCHEMA_VERSION}`

db.exec """
  CREATE TABLE IF NOT EXISTS documents (
    url           TEXT PRIMARY KEY,
    content       TEXT NOT NULL,
    content_hash  TEXT NOT NULL,
    fetched_at    INTEGER NOT NULL,
    expires_at    INTEGER,
    etag          TEXT,
    last_modified TEXT,
    resolved_url  TEXT
  );
  CREATE INDEX IF NOT EXISTS idx_documents_expires ON documents(expires_at)
    WHERE expires_at IS NOT NULL;

  CREATE TABLE IF NOT EXISTS document_sources (
    doc_url    TEXT NOT NULL,
    source_url TEXT NOT NULL,
    PRIMARY KEY (doc_url, source_url)
  );
  CREATE INDEX IF NOT EXISTS idx_document_sources_source ON document_sources(source_url);

  CREATE VIRTUAL TABLE IF NOT EXISTS documents_fts USING fts5(
    url UNINDEXED,
    content,
    content='documents',
    content_rowid='rowid',
    tokenize='porter unicode61 remove_diacritics 1'
  );

  CREATE TRIGGER IF NOT EXISTS documents_ai AFTER INSERT ON documents BEGIN
    INSERT INTO documents_fts(rowid, url, content) VALUES (new.rowid, new.url, new.content);
  END;
  CREATE TRIGGER IF NOT EXISTS documents_ad AFTER DELETE ON documents BEGIN
    INSERT INTO documents_fts(documents_fts, rowid, url, content)
      VALUES ('delete', old.rowid, old.url, old.content);
  END;
  CREATE TRIGGER IF NOT EXISTS documents_au AFTER UPDATE ON documents BEGIN
    INSERT INTO documents_fts(documents_fts, rowid, url, content)
      VALUES ('delete', old.rowid, old.url, old.content);
    INSERT INTO documents_fts(rowid, url, content) VALUES (new.rowid, new.url, new.content);
  END;
"""

if vecAvailable
  db.exec """
    CREATE VIRTUAL TABLE IF NOT EXISTS vec_chunks USING vec0(
      doc_url TEXT,
      chunk_idx INTEGER,
      +chunk_text TEXT,
      embedding float[384]
    )
  """

// Concrete classes (not interfaces) so bun:sqlite `.as(Class)` produces rows
// that all share a single V8 hidden class — monomorphic IC at every callsite.
export class Document
  url: string = ""
  content: string = ""
  content_hash: string = ""
  fetched_at: number = 0
  expires_at: number | null = null
  etag: string | null = null
  last_modified: string | null = null
  resolved_url: string | null = null

export class DocumentSource
  doc_url: string = ""
  source_url: string = ""

// Lean projection for listings — url + timestamps, no content payload.
export class DocListing
  url: string = ""
  fetched_at: number = 0
  expires_at: number | null = null

export class SearchHit
  url: string = ""
  snippet: string = ""
  score: number = 0

export class VectorHit
  url: string = ""
  chunk_text: string = ""
  chunk_idx: number = 0
  score: number = 0

export class SourceSummary
  source_url: string = ""
  doc_count: number = 0
  last_fetched: number = 0

getDocStmt := (db.prepare<Document, [string]> "SELECT url, content, content_hash, fetched_at, expires_at, etag, last_modified, resolved_url FROM documents WHERE url = ?").as Document

// Positional params — no per-call object literal allocation, no named-binding lookups.
upsertDocStmt := db.prepare<unknown, [string, string, string, number, number | null, string | null, string | null, string | null]> """
  INSERT INTO documents (url, content, content_hash, fetched_at, expires_at, etag, last_modified, resolved_url)
  VALUES (?, ?, ?, ?, ?, ?, ?, ?)
  ON CONFLICT(url) DO UPDATE SET
    content = excluded.content,
    content_hash = excluded.content_hash,
    fetched_at = excluded.fetched_at,
    expires_at = excluded.expires_at,
    etag = excluded.etag,
    last_modified = excluded.last_modified,
    resolved_url = excluded.resolved_url
"""

deleteDocStmt := db.prepare "DELETE FROM documents WHERE url = ?"

listDocsStmt := (db.prepare<Document, []> "SELECT url, content, content_hash, fetched_at, expires_at, etag, last_modified, resolved_url FROM documents ORDER BY fetched_at DESC").as Document

listDocsBySourceStmt := (db.prepare<Document, [string]> """
  SELECT d.url, d.content, d.content_hash, d.fetched_at, d.expires_at, d.etag, d.last_modified, d.resolved_url FROM documents d
  JOIN document_sources ds ON ds.doc_url = d.url
  WHERE ds.source_url = ?
  ORDER BY d.fetched_at DESC
""").as Document

// Paginated listing — selects only the columns `lx list` renders (no content
// payload) and pushes LIMIT/OFFSET into SQLite so a large cache never loads every
// row into memory just to print URLs.
listDocsPageStmt := (db.prepare<DocListing, [number, number]> "SELECT url, fetched_at, expires_at FROM documents ORDER BY fetched_at DESC LIMIT ? OFFSET ?").as DocListing

listDocsPageBySourceStmt := (db.prepare<DocListing, [string, number, number]> """
  SELECT d.url, d.fetched_at, d.expires_at FROM documents d
  JOIN document_sources ds ON ds.doc_url = d.url
  WHERE ds.source_url = ?
  ORDER BY d.fetched_at DESC
  LIMIT ? OFFSET ?
""").as DocListing

countDocsStmt := db.prepare<{ n: number }, []> "SELECT COUNT(*) AS n FROM documents"
countDocsBySourceStmt := db.prepare<{ n: number }, [string]> """
  SELECT COUNT(*) AS n FROM documents d
  JOIN document_sources ds ON ds.doc_url = d.url
  WHERE ds.source_url = ?
"""

upsertSourceStmt := db.prepare """
  INSERT OR IGNORE INTO document_sources (doc_url, source_url) VALUES (?, ?)
"""

clearSourcesForDocStmt := db.prepare "DELETE FROM document_sources WHERE doc_url = ?"

listSourcesStmt := (db.prepare<SourceSummary, []> """
  SELECT
    ds.source_url AS source_url,
    COUNT(*) AS doc_count,
    MAX(d.fetched_at) AS last_fetched
  FROM document_sources ds
  JOIN documents d ON d.url = ds.doc_url
  GROUP BY ds.source_url
  ORDER BY last_fetched DESC
""").as SourceSummary

export getDocument := (url: string): Document | null =>
  getDocStmt.get url

export interface UpsertInput
  url: string
  content: string
  content_hash: string
  fetched_at?: number
  expires_at: number | null
  etag: string | null
  last_modified: string | null
  resolved_url?: string | null

export upsertDocument := (doc: UpsertInput): void =>
  fetchedAt := doc.fetched_at ?? Math.floor(Date.now() / 1000)
  upsertDocStmt.run doc.url, doc.content, doc.content_hash, fetchedAt, doc.expires_at, doc.etag, doc.last_modified, doc.resolved_url ?? null

// Wraps a batch of upserts in a single transaction — collapses N fsyncs into 1.
bulkUpsertTxn := db.transaction (rows: UpsertInput[]) =>
  for row of rows
    fetchedAt := row.fetched_at ?? Math.floor(Date.now() / 1000)
    upsertDocStmt.run row.url, row.content, row.content_hash, fetchedAt, row.expires_at, row.etag, row.last_modified, row.resolved_url ?? null
  return

export bulkUpsertDocuments := (rows: UpsertInput[]): void =>
  unless rows.length then return
  bulkUpsertTxn rows

export deleteDocument := (url: string): void =>
  deleteDocStmt.run url

export listDocuments := (source?: string): Document[] =>
  if source? then listDocsBySourceStmt.all source
  else listDocsStmt.all()

export interface ListPageOptions
  source?: string
  limit: number
  offset: number

export listDocumentsPage := (opts: ListPageOptions): DocListing[] =>
  if opts.source? then listDocsPageBySourceStmt.all opts.source, opts.limit, opts.offset
  else listDocsPageStmt.all opts.limit, opts.offset

export countDocuments := (source?: string): number =>
  row := if source? then countDocsBySourceStmt.get source else countDocsStmt.get()
  row?.n ?? 0

export linkDocumentToSource := (docUrl: string, sourceUrl: string): void =>
  upsertSourceStmt.run docUrl, sourceUrl

export clearSourcesForDocument := (docUrl: string): void =>
  clearSourcesForDocStmt.run docUrl

export listSources := (): SourceSummary[] =>
  listSourcesStmt.all()

searchFtsStmt := (db.prepare<SearchHit, [string, number]> """
  SELECT
    d.url AS url,
    snippet(documents_fts, 1, char(2), char(3), '…', 16) AS snippet,
    bm25(documents_fts) AS score
  FROM documents_fts
  JOIN documents d ON d.rowid = documents_fts.rowid
  WHERE documents_fts MATCH ?
  ORDER BY bm25(documents_fts)
  LIMIT ?
""").as SearchHit

searchFtsBySourceStmt := (db.prepare<SearchHit, [string, string, number]> """
  SELECT
    d.url AS url,
    snippet(documents_fts, 1, char(2), char(3), '…', 16) AS snippet,
    bm25(documents_fts) AS score
  FROM documents_fts
  JOIN documents d ON d.rowid = documents_fts.rowid
  JOIN document_sources ds ON ds.doc_url = d.url
  WHERE documents_fts MATCH ? AND ds.source_url = ?
  ORDER BY bm25(documents_fts)
  LIMIT ?
""").as SearchHit

export searchFts := (query: string, limit: number, source?: string): SearchHit[] =>
  if source? then searchFtsBySourceStmt.all query, source, limit
  else searchFtsStmt.all query, limit

deleteVecChunksStmt: { run: (docUrl: string) => void } | null .= null
insertVecChunkStmt: { run: (docUrl: string, chunkIdx: number, chunkText: string, embedding: Uint8Array) => void } | null .= null
bulkInsertVecChunksFn: ((rows: { docUrl: string, chunkIdx: number, chunkText: string, embedding: Uint8Array }[]) => void) | null .= null
vectorSearchAllStmt: { all: (buf: Uint8Array, topK: number) => VectorHit[] } | null .= null
vectorSearchBySourceStmt: { all: (buf: Uint8Array, topK: number, sourceUrl: string) => VectorHit[] } | null .= null

if vecAvailable
  delStmt := db.prepare "DELETE FROM vec_chunks WHERE doc_url = ?"
  deleteVecChunksStmt = { run: (docUrl: string) => { delStmt.run docUrl; return } }
  insStmt := db.prepare """
    INSERT INTO vec_chunks (doc_url, chunk_idx, chunk_text, embedding)
    VALUES (?, ?, ?, ?)
  """
  insertVecChunkStmt = { run: (docUrl, chunkIdx, chunkText, embedding) => { insStmt.run docUrl, chunkIdx, chunkText, embedding; return } }
  bulkInsTxn := db.transaction (rows: { docUrl: string, chunkIdx: number, chunkText: string, embedding: Uint8Array }[]) =>
    for r of rows
      insStmt.run r.docUrl, r.chunkIdx, r.chunkText, r.embedding
    return
  bulkInsertVecChunksFn = bulkInsTxn

  vAll := (db.prepare<VectorHit, [Uint8Array, number]> """
    SELECT doc_url AS url, chunk_text, chunk_idx, distance AS score
    FROM vec_chunks
    WHERE embedding MATCH ? AND k = ?
    ORDER BY distance
  """).as VectorHit
  vectorSearchAllStmt = { all: (buf, topK) => vAll.all buf, topK }

  // json_each lets us scope to N doc_urls without re-preparing per call.
  vBySrc := (db.prepare<VectorHit, [Uint8Array, number, string]> """
    SELECT doc_url AS url, chunk_text, chunk_idx, distance AS score
    FROM vec_chunks
    WHERE embedding MATCH ? AND k = ?
      AND doc_url IN (
        SELECT doc_url FROM document_sources WHERE source_url = ?
      )
    ORDER BY distance
  """).as VectorHit
  vectorSearchBySourceStmt = { all: (buf, topK, sourceUrl) => vBySrc.all buf, topK, sourceUrl }

export deleteVecChunks := (docUrl: string): void =>
  deleteVecChunksStmt?.run docUrl

export insertVecChunk := (params: {docUrl: string, chunkIdx: number, chunkText: string, embedding: Float32Array}): void =>
  unless insertVecChunkStmt? then return
  buf := new Uint8Array params.embedding.buffer, params.embedding.byteOffset, params.embedding.byteLength
  insertVecChunkStmt.run params.docUrl, params.chunkIdx, params.chunkText, buf

export bulkInsertVecChunks := (rows: { docUrl: string, chunkIdx: number, chunkText: string, embedding: Float32Array }[]): void =>
  unless bulkInsertVecChunksFn? and rows.length then return
  // Pre-materialize Uint8Array views once so the transaction loop stays allocation-light.
  prepared := rows.map (r) => {
    docUrl: r.docUrl
    chunkIdx: r.chunkIdx
    chunkText: r.chunkText
    embedding: new Uint8Array r.embedding.buffer, r.embedding.byteOffset, r.embedding.byteLength
  }
  bulkInsertVecChunksFn prepared

export vectorSearch := (queryEmbedding: Float32Array, topK: number, source?: string): VectorHit[] =>
  unless vecAvailable then return []
  buf := new Uint8Array queryEmbedding.buffer, queryEmbedding.byteOffset, queryEmbedding.byteLength
  if source?
    vectorSearchBySourceStmt!.all buf, topK, source
  else
    vectorSearchAllStmt!.all buf, topK

unembeddedDocsStmt: { all: () => Document[] } | null .= null
unembeddedDocsBySourceStmt: { all: (source: string) => Document[] } | null .= null
if vecAvailable
  s1 := (db.prepare<Document, []> """
    SELECT d.url, d.content, d.content_hash, d.fetched_at, d.expires_at, d.etag, d.last_modified, d.resolved_url FROM documents d
    WHERE NOT EXISTS (SELECT 1 FROM vec_chunks vc WHERE vc.doc_url = d.url)
  """).as Document
  unembeddedDocsStmt = { all: () => s1.all() }
  s2 := (db.prepare<Document, [string]> """
    SELECT d.url, d.content, d.content_hash, d.fetched_at, d.expires_at, d.etag, d.last_modified, d.resolved_url FROM documents d
    JOIN document_sources ds ON ds.doc_url = d.url
    WHERE ds.source_url = ?
      AND NOT EXISTS (SELECT 1 FROM vec_chunks vc WHERE vc.doc_url = d.url)
  """).as Document
  unembeddedDocsBySourceStmt = { all: (source: string) => s2.all source }

export listUnembeddedDocs := (source?: string): Document[] =>
  unless vecAvailable then return []
  if source? then (unembeddedDocsBySourceStmt!.all source)
  else unembeddedDocsStmt!.all()

export _clearDocuments := (): void =>
  db.run "DELETE FROM documents"
  db.run "DELETE FROM document_sources"
  if vecAvailable then db.run "DELETE FROM vec_chunks"
