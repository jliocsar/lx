{ bulkInsertVecChunks, deleteVecChunks, isVecAvailable } from ./db.civet
{ join } from node:path
{ homedir } from node:os

MODEL_ID := "Xenova/all-MiniLM-L6-v2"

export isEmbedEnabled := (): boolean =>
  v := process.env.LX_EMBED_ENABLED
  v is "1" or v is "true"

embedderPromise: Promise<any> | null .= null
ragModulePromise: Promise<any> | null .= null

// Dynamic import keeps transformers.js (and onnxruntime-node) out of the eager load graph.
// Standalone binary builds skip embedding via LX_EMBED_ENABLED; the binary never reaches this path.
loadEmbedder := async (): Promise<any> =>
  unless embedderPromise?
    embedderPromise = (async () =>
      mod := await import "@huggingface/transformers"
      mod.env.cacheDir = join homedir(), ".cache", "lx", "models"
      mod.env.allowRemoteModels = true
      await mod.pipeline "feature-extraction", MODEL_ID, { dtype: "q8" }
    )()
  embedderPromise

// Cache the @mastra/rag import — it has a non-trivial startup cost and the module
// is referenced by every embedDocument call.
loadRag := (): Promise<any> =>
  unless ragModulePromise?
    ragModulePromise = import "@mastra/rag"
  ragModulePromise

export interface MarkdownChunk
  text: string
  h1?: string
  h2?: string
  h3?: string

export chunkMarkdown := async (content: string): Promise<MarkdownChunk[]> =>
  mod := await loadRag()
  doc := mod.MDocument.fromMarkdown content
  chunks := await doc.chunk
    strategy: 'markdown'
    headers: [
      ['#', 'h1']
      ['##', 'h2']
      ['###', 'h3']
    ]
    stripHeaders: true
  out: MarkdownChunk[] := []
  for c of chunks
    text := (c.text ?? "").trim()
    if text.length > 0
      out.push { text, h1: c.metadata?.h1, h2: c.metadata?.h2, h3: c.metadata?.h3 }
  out

export embedText := async (text: string): Promise<Float32Array> =>
  pipe := await loadEmbedder()
  out := await pipe text, { pooling: "mean", normalize: true }
  out.data as Float32Array

// Batch variant — transformers.js feature-extraction accepts string[] and returns
// a single tensor with `.data` packed N × dim. One forward pass instead of N.
embedBatch := async (texts: string[]): Promise<Float32Array[]> =>
  unless texts.length then return []
  pipe := await loadEmbedder()
  out := await pipe texts, { pooling: "mean", normalize: true }
  dim := (out.data.length / texts.length) | 0
  result: Float32Array[] := new Array texts.length
  for i .= 0; i < texts.length; i++
    result[i] = (out.data as Float32Array).slice i * dim, (i + 1) * dim
  result

export interface EmbedDeps
  embedText?: typeof embedText
  chunkMarkdown?: typeof chunkMarkdown

export embedDocument := async (url: string, content: string, deps?: EmbedDeps): Promise<void> =>
  unless isEmbedEnabled() and isVecAvailable() then return
  _chunkMarkdown := deps?.chunkMarkdown ?? chunkMarkdown
  deleteVecChunks url
  chunks := await _chunkMarkdown content
  unless chunks.length then return

  // Build input texts once and either batch (default) or fall back to the injected
  // embedText (test path) to stay backwards-compatible with the existing test mocks.
  inputs: string[] := new Array chunks.length
  for i .= 0; i < chunks.length; i++
    chunk := chunks[i]!
    headerPath := [chunk.h1, chunk.h2, chunk.h3].filter(Boolean).join " > "
    inputs[i] = if headerPath then `${headerPath}\n${chunk.text}` else chunk.text

  embeddings: Float32Array[] := if deps?.embedText?
    out: Float32Array[] := new Array chunks.length
    for i .= 0; i < chunks.length; i++
      out[i] = await deps.embedText! inputs[i]!
    out
  else
    await embedBatch inputs

  // Single transaction for all chunk inserts — N statement.run calls share one commit.
  rows := new Array chunks.length
  for i .= 0; i < chunks.length; i++
    rows[i] =
      docUrl: url
      chunkIdx: i
      chunkText: chunks[i]!.text
      embedding: embeddings[i]!
  bulkInsertVecChunks rows
