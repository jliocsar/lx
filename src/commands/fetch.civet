{ getDocument, upsertDocument, deleteDocument, deleteVecChunks, clearSourcesForDocument } from ../db.civet
{ fetchDoc, fetchWithStrategies, type FetchResult } from ../fetch.civet
{ parseLlmsTxt, fetchAndCacheLinks } from ../crawl.civet
{ parseTTL, computeExpiresAt, isExpired } from ../cache.civet
{ embedDocument, isEmbedEnabled } from ../embed.civet
{ sha256Hex } from ../hash.civet

export interface FetchOptions
  ttl: string
  fresh: boolean
  range?: string
  quiet?: boolean
  verbose?: boolean

validateUrl := (raw: string): URL =>
  unless URL.canParse raw
    process.stderr.write `Error: invalid URL: ${raw}\n`
    process.exit 2

  url := new URL raw

  unless url.protocol is "https:" or url.protocol is "http:"
    process.stderr.write "Error: URL must use http or https\n"
    process.exit 2

  url

// A direct route fetches one known markdown resource: llms.txt (crawled), llms-full.txt
// (single dump), or an explicit .md/.mdx. Everything else is an arbitrary URL routed
// through the fallback chain.
isDirectRoute := (pathname: string): boolean =>
  pathname.endsWith("/llms.txt") or
  pathname.endsWith("/llms-full.txt") or
  pathname.endsWith(".md") or
  pathname.endsWith(".mdx")

isLlmsFullRoute := (pathname: string): boolean =>
  pathname.endsWith "/llms-full.txt"

applyRange := (content: string, range: string): string =>
  match := range.match /^(\d+):(\d+)$/
  unless match
    process.stderr.write `Error: invalid --range format: ${range} — expected start:end\n`
    process.exit 2

  [, startStr, endStr] := match
  start := parseInt startStr!, 10
  end := parseInt endStr!, 10

  content.split("\n").slice(start - 1, end).join "\n"

contentLines := (content: string): string[] =>
  lines := content.split "\n"
  if lines.length > 0 and lines[lines.length - 1] is ""
    lines.pop()
  lines

csvQuote := (value: string): string =>
  `"${value.replace(/"/g, '""')}"`

formatLineRange := (start: number, end: number): string =>
  if start is end then `${start}` else `${start}:${end}`

summarizeLlmsFull := (url: string, content: string): string =>
  lines := contentLines content
  headings: { level: number, title: string, line: number }[] .= []
  fenceChar: string | null .= null

  for line, idx of lines
    trimmedStart := line.trimStart()
    if fenceChar?
      if trimmedStart.startsWith fenceChar.repeat 3
        fenceChar = null
      continue

    if trimmedStart.startsWith "```"
      fenceChar = "`"
      continue
    if trimmedStart.startsWith "~~~"
      fenceChar = "~"
      continue

    match := line.match /^(#{1,3})(?!#)\s+(.+?)\s*$/
    if match
      level := match[1]!.length
      title := match[2]!.replace(/\s+#+\s*$/, "").trim()
      if title
        headings.push { level, title, line: idx + 1 }

  out := [`${url}`, `line count: ${lines.length}`, "", "level,title,line range"]
  for heading, idx of headings
    next := headings[idx + 1]
    endLine := (next?.line ?? (lines.length + 1)) - 1
    out.push `${heading.level},${csvQuote heading.title},${formatLineRange heading.line, endLine}`
  out.join "\n"

writeOutput := (url: URL, content: string, opts: FetchOptions, quiet: boolean): void =>
  if quiet then return
  out :=
    if isLlmsFullRoute(url.pathname) and not opts.verbose and not opts.range
      summarizeLlmsFull url.toString(), content
    else if opts.range?
      applyRange content, opts.range
    else
      content
  process.stdout.write out
  unless out.endsWith "\n"
    process.stdout.write "\n"

export runFetch := async (raw: string, opts: FetchOptions): Promise<void> =>
  url := validateUrl raw
  urlStr := url.toString()
  quiet := opts.quiet ?? false

  if opts.fresh
    deleteDocument urlStr
    deleteVecChunks urlStr
    clearSourcesForDocument urlStr

  cached := getDocument urlStr

  if cached and not isExpired cached
    writeOutput url, cached.content, opts, quiet
    return

  ttlSeconds := parseTTL opts.ttl
  now := Math.floor Date.now() / 1000
  expiresAt := computeExpiresAt now, ttlSeconds

  result: FetchResult | null .= null
  resolvedUrl: string | null .= cached?.resolved_url ?? null

  if cached
    // Revalidation — we already know where this content lives. One conditional request
    // against resolved_url (or the key when no redirect happened); never re-run the chain.
    result = await fetchDoc (cached.resolved_url ?? urlStr),
      etag: cached.etag
      lastModified: cached.last_modified
  else if isDirectRoute url.pathname
    result = await fetchDoc urlStr
  else
    // Arbitrary URL, first acquisition → run the fallback chain.
    try
      strategy := await fetchWithStrategies urlStr
      result = strategy.result
      resolvedUrl = strategy.resolvedUrl
    catch err
      process.stderr.write `Error: ${(err as Error).message}\n`
      process.exit 1

  if not result and cached
    upsertDocument
      url: urlStr
      content: cached.content
      content_hash: cached.content_hash
      fetched_at: now
      expires_at: expiresAt
      etag: cached.etag
      last_modified: cached.last_modified
      resolved_url: cached.resolved_url
    writeOutput url, cached.content, opts, quiet
    return

  unless result
    process.stderr.write `Error: no content returned for ${urlStr}\n`
    process.exit 1

  newHash := sha256Hex result.content
  contentChanged := not cached or cached.content_hash !== newHash

  upsertDocument
    url: urlStr
    content: result.content
    content_hash: newHash
    fetched_at: now
    expires_at: expiresAt
    etag: result.etag
    last_modified: result.lastModified
    resolved_url: resolvedUrl

  if url.pathname.endsWith "/llms.txt"
    try
      { links } := parseLlmsTxt result.content
      await fetchAndCacheLinks links, { ttl: opts.ttl, sourceUrl: urlStr }
    catch err
      process.stderr.write `Error: ${(err as Error).message}\n`
      process.exit 1
  else if contentChanged and isEmbedEnabled()
    try
      await embedDocument urlStr, result.content
    catch err
      process.stderr.write `Warning: embed failed for ${urlStr}: ${(err as Error).message}\n`

  writeOutput url, result.content, opts, quiet
