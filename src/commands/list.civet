{ listDocumentsPage, countDocuments } from ../db.civet

formatDate := (ts: number): string =>
  new Date(ts * 1000).toISOString().slice 0, 19

formatTTL := (expiresAt: number | null): string =>
  unless expiresAt? then return "never"
  remaining := expiresAt - Math.floor(Date.now() / 1000)
  if remaining <= 0 then return "expired"
  if remaining < 60 then return `${remaining}s`
  if remaining < 3600 then return `${Math.floor remaining / 60}m`
  if remaining < 86400 then return `${Math.floor remaining / 3600}h`
  `${Math.floor remaining / 86400}d`

DEFAULT_LIMIT := 50

export interface ListOptions
  source?: string
  limit?: number
  offset?: number

export runList := (opts?: ListOptions): void =>
  limit := opts?.limit ?? DEFAULT_LIMIT
  offset := opts?.offset ?? 0

  total := countDocuments opts?.source
  if total is 0
    process.stderr.write "No cached documents. Fetch one to populate the cache, e.g. lx fetch https://bun.sh/llms.txt\n"
    return

  docs := listDocumentsPage { source: opts?.source, limit, offset }
  if docs.length is 0
    process.stderr.write `No documents at offset ${offset} (cache holds ${total}). Try a smaller --offset.\n`
    return

  for doc of docs
    ttl := formatTTL doc.expires_at
    fetched := formatDate doc.fetched_at
    process.stdout.write `${doc.url}\n  fetched: ${fetched}  ttl: ${ttl}\n`

  // Pagination footer (stderr, so stdout stays a clean URL list for piping).
  shownEnd := offset + docs.length
  if shownEnd < total or offset > 0
    process.stderr.write `Showing ${offset + 1}–${shownEnd} of ${total}.`
    if shownEnd < total
      next .= `lx list --offset ${shownEnd}`
      if limit !== DEFAULT_LIMIT then next += ` --limit ${limit}`
      if opts?.source? then next += ` --source ${opts.source}`
      process.stderr.write ` Next page: ${next}`
    process.stderr.write "\n"
