{ listDocumentsPage, countDocuments, listRootDocuments, countRootDocuments, listAllChildren } from ../db.civet

formatDate := (ts: number): string =>
  new Date(ts * 1000).toISOString().slice 0, 19

formatTTL := (expiresAt: number | null): string =>
  unless expiresAt? then return "never"
  remaining := expiresAt - Math.floor(Date.now() / 1000)
  if remaining <= 0 then return "expired"
  if remaining < 60 then return `${remaining}s`
  if remaining < 3600 then return `${Math.floor remaining / 60}m`
  if remaining < 86400 then return `${Math.floor remaining / 3600}h`
  `${Math.floor remaining / 86400}d`

DEFAULT_LIMIT := 50

export interface ListOptions
  source?: string
  all?: boolean
  limit?: number
  offset?: number

renderDoc := (url: string, fetchedAt: number, expiresAt: number | null): string =>
  `${url}\n  fetched: ${formatDate fetchedAt}  ttl: ${formatTTL expiresAt}\n`

writeFooter := (offset: number, shown: number, total: number, limit: number, opts?: ListOptions): void =>
  shownEnd := offset + shown
  unless shownEnd < total or offset > 0 then return
  process.stderr.write `Showing ${offset + 1}–${shownEnd} of ${total}.`
  if shownEnd < total
    next .= `lx list --offset ${shownEnd}`
    if opts?.all then next += " --all"
    if limit >= 0 and limit !== DEFAULT_LIMIT then next += ` --limit ${limit}`
    if opts?.source? then next += ` --source ${opts.source}`
    process.stderr.write ` Next page: ${next}`
  process.stderr.write "\n"

export runList := (opts?: ListOptions): void =>
  all := opts?.all ?? false
  offset := opts?.offset ?? 0
  // --all lifts the default cap (SQLite treats LIMIT -1 as unlimited) unless the
  // caller passed an explicit --limit.
  limit := opts?.limit ?? (if all then -1 else DEFAULT_LIMIT)

  // Flat view scoped to a single source's crawled docs.
  if opts?.source?
    total := countDocuments opts.source
    if total is 0
      process.stderr.write `No cached documents for source ${opts.source}. Fetch it with: lx fetch ${opts.source}\n`
      return
    docs := listDocumentsPage { source: opts.source, limit, offset }
    if docs.length is 0
      process.stderr.write `No documents at offset ${offset} (source holds ${total}). Try a smaller --offset.\n`
      return
    for doc of docs
      process.stdout.write renderDoc doc.url, doc.fetched_at, doc.expires_at
    writeFooter offset, docs.length, total, limit, opts
    return

  // Default: only top-level roots (llms.txt sources + standalone docs that aren't
  // crawled children of any source).
  total := countRootDocuments()
  if total is 0
    process.stderr.write "No cached documents. Fetch one to populate the cache, e.g. lx fetch https://bun.sh/llms.txt\n"
    return
  roots := listRootDocuments { limit, offset }
  if roots.length is 0
    process.stderr.write `No documents at offset ${offset} (cache holds ${total} root doc(s)). Try a smaller --offset.\n`
    return

  if all
    // Group every crawled child under its root in a single pass.
    childrenBySource := new Map<string, string[]>()
    for child of listAllChildren()
      existing := childrenBySource.get child.source_url
      if existing? then existing.push child.url
      else childrenBySource.set child.source_url, [child.url]
    for root of roots
      process.stdout.write `${root.url}\n`
      for childUrl of childrenBySource.get(root.url) ?? []
        process.stdout.write `    ${childUrl}\n`
  else
    for root of roots
      process.stdout.write renderDoc root.url, root.fetched_at, root.expires_at

  writeFooter offset, roots.length, total, limit, opts
