{ test, expect, describe, beforeEach, afterEach, spyOn } from bun:test
{ runList } from ./list.civet
{ upsertDocument, linkDocumentToSource, _clearDocuments } from ../db.civet

describe 'list', =>
  stdoutOutput .= ''
  stderrOutput .= ''
  stdoutSpy .= null as ReturnType<typeof spyOn> | null
  stderrSpy .= null as ReturnType<typeof spyOn> | null
  now := Math.floor Date.now() / 1000

  beforeEach =>
    _clearDocuments()
    stdoutOutput = ''
    stderrOutput = ''
    stdoutSpy = spyOn(process.stdout, 'write').mockImplementation (chunk: string) =>
      stdoutOutput += chunk
      true as any
    stderrSpy = spyOn(process.stderr, 'write').mockImplementation (chunk: string) =>
      stderrOutput += chunk
      true as any

  afterEach =>
    stdoutSpy?.mockRestore()
    stderrSpy?.mockRestore()

  seed := (url: string, expiresAt: number | null) =>
    upsertDocument
      url: url
      content: '# Test'
      content_hash: 'h0'
      fetched_at: now
      expires_at: expiresAt
      etag: null
      last_modified: null

  test 'empty cache → stderr notice', =>
    runList()
    expect(stderrOutput).toContain 'No cached documents'
    expect(stdoutOutput).toBe ''

  test 'shows URL and fetched date', =>
    seed 'https://example.com/doc.md', null
    runList()
    expect(stdoutOutput).toContain 'https://example.com/doc.md'
    expect(stdoutOutput).toMatch /fetched:/

  test 'TTL: never (null expires_at)', =>
    seed 'https://a.com/a.md', null
    runList()
    expect(stdoutOutput).toContain 'never'

  test 'TTL: expired', =>
    seed 'https://a.com/a.md', now - 1
    runList()
    expect(stdoutOutput).toContain 'expired'

  test 'TTL: seconds', =>
    seed 'https://a.com/a.md', now + 30
    runList()
    expect(stdoutOutput).toMatch /\d+s/

  test 'TTL: minutes', =>
    seed 'https://a.com/a.md', now + 120
    runList()
    expect(stdoutOutput).toMatch /\d+m/

  test 'TTL: hours', =>
    seed 'https://a.com/a.md', now + 7200
    runList()
    expect(stdoutOutput).toMatch /\d+h/

  test 'TTL: days', =>
    seed 'https://a.com/a.md', now + 86400 * 3
    runList()
    expect(stdoutOutput).toMatch /\d+d/

  test 'multiple docs all shown', =>
    seed 'https://a.com/a.md', null
    seed 'https://b.com/b.md', null
    runList()
    expect(stdoutOutput).toContain 'https://a.com/a.md'
    expect(stdoutOutput).toContain 'https://b.com/b.md'

  test 'limit caps output and prints a paginated footer', =>
    for i of [1..5]
      seed `https://x.com/${i}.md`, null
    runList { limit: 2 }
    matches := stdoutOutput.match(/https:\/\/x\.com\//g) ?? []
    expect(matches.length).toBe 2
    expect(stderrOutput).toContain 'Showing 1–2 of 5'
    expect(stderrOutput).toContain 'lx list --offset 2 --limit 2'

  test 'offset pages through and shows position', =>
    for i of [1..5]
      seed `https://x.com/${i}.md`, null
    runList { limit: 2, offset: 4 }
    matches := stdoutOutput.match(/https:\/\/x\.com\//g) ?? []
    expect(matches.length).toBe 1
    expect(stderrOutput).toContain 'Showing 5–5 of 5'
    expect(stderrOutput).not.toContain 'Next page'

  test 'offset past end → notice, no crash', =>
    seed 'https://x.com/a.md', null
    runList { offset: 50 }
    expect(stdoutOutput).toBe ''
    expect(stderrOutput).toContain 'No documents at offset 50'

  test 'small cache prints no footer', =>
    seed 'https://a.com/a.md', null
    runList()
    expect(stderrOutput).toBe ''

  describe 'roots and nesting', =>
    seedTree := =>
      seed 'https://ai-sdk.dev/llms.txt', null
      seed 'https://ai-sdk.dev/docs/getting-started.md', null
      seed 'https://ai-sdk.dev/docs/api.md', null
      seed 'https://standalone.com/notes.md', null
      linkDocumentToSource 'https://ai-sdk.dev/docs/getting-started.md', 'https://ai-sdk.dev/llms.txt'
      linkDocumentToSource 'https://ai-sdk.dev/docs/api.md', 'https://ai-sdk.dev/llms.txt'

    test 'default shows only top-level roots, not crawled children', =>
      seedTree()
      runList()
      expect(stdoutOutput).toContain 'https://ai-sdk.dev/llms.txt'
      expect(stdoutOutput).toContain 'https://standalone.com/notes.md'
      expect(stdoutOutput).not.toContain 'getting-started.md'
      expect(stdoutOutput).not.toContain 'docs/api.md'

    test 'default annotates roots with a crawled-doc count', =>
      seedTree()
      runList()
      expect(stdoutOutput).toContain '2 crawled doc(s)'

    test '--all nests children under their root, indented', =>
      seedTree()
      runList { all: true }
      expect(stdoutOutput).toContain 'https://ai-sdk.dev/llms.txt\n    https://ai-sdk.dev/docs/'
      expect(stdoutOutput).toContain '    https://ai-sdk.dev/docs/getting-started.md'
      expect(stdoutOutput).toContain '    https://ai-sdk.dev/docs/api.md'
      // standalone root still appears with no children under it
      expect(stdoutOutput).toContain 'https://standalone.com/notes.md'
